# Session state and temporary files
todos/
/plans/
file-history/
debug/
shell-snapshots/
session-env/
tasks/

# Conversation logs — NEVER commit these (contain secrets, PII, session data)
*.jsonl

# NARROW EXEMPTION: synthetic test fixtures, not conversation logs.
# tests/fixtures/**/ holds hand-generated .jsonl used by the bats suite. These
# carry ONLY a synthetic requestId, a role string, and four integer token
# counters -- no content blocks, no file paths, no prose, no PII. Audited before
# this exemption was added; re-audit before adding files here.
#
# They exist because the budget guard's central claim ("would have blocked the
# one runaway agent, allowed the other four") was otherwise verifiable only on
# the single machine holding the original ~/.claude/projects/ transcripts. The
# blanket rule above silently excluded them, which shipped tests that pass
# locally and fail on a fresh clone. Keep the exemption this narrow.
!tests/fixtures/**/*.jsonl

# Cache and statistics
mcp-needs-auth-cache.json
stats-cache.json
statsig/
cache/
paste-cache/
image-cache/
plugins/install-counts-cache.json
plugins/known_marketplaces.json
plugins/installed_plugins.json
plugins/marketplaces/*/
plugins/cache/

# Local configuration (personal settings, permissions)
settings.local.json
*.local.json
mcp.json

# Secrets and credentials — never commit
*.key
*.pem
*.p12
credentials.*
secrets.*

# Project directories (external projects worked on)
projects/

# Telemetry and analytics
telemetry/

# macOS metadata
.DS_Store
**/.DS_Store

# Python bytecode (generated by py_compile, imports, etc.)
__pycache__/
*.pyc

# BFG reports
*.bfg-report/

# Auto-memory (may contain sensitive session context)
memory/

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/

# Empty directories and misc
bin/
commands/
downloads/
agents-local/
logs/
agents.backup/
.claude.json*
blocked-commands.log
last-review-result.log
merge-locks/
pending-issues/
plugins/blocklist.json
.credentials.json
sessions/
