{
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "/Volumes/extra-vieille/Workspaces",
        "~/.dotfiles",
        "~/.fastlane/spaceship",
        "${GDRIVE_HANDOFF}"
      ]
    },
    "excludedCommands": [
      "${HOME}/Library/Android/sdk/emulator/emulator *",
      "adb *",
      "emulator *",
      "maestro *",
      "npm run android:emulator*",
      "npm run ios:simulator*",
      "npm run test:e2e:android*",
      "npm run test:e2e:ios*",
      "open -a Simulator*",
      "xcrun simctl *"
    ],
    "network": {
      "allowedDomains": [
        "api.expo.dev",
        "api.cloudflare.com",
        "dash.cloudflare.com",
        "valuation-api-staging.andrew-3c6.workers.dev",
        "rubygems.org",
        "appstoreconnect.apple.com",
        "api.appstoreconnect.apple.com",
        "idmsa.apple.com",
        "www.googleapis.com"
      ]
    }
  }
}
