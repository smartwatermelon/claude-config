{
  "hooks": {
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.config/claude-code/hooks/log-permission-denied.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": ["${GDRIVE_HANDOFF}"]
    }
  }
}
