{
  "advisorModel": "fable",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactWindow": 400000,
  "autoContinueAtUsageLimit": true,
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Linear"
    },
    {
      "serverName": "claude.ai Sentry"
    },
    {
      "serverName": "claude.ai Slack"
    }
  ],
  "editorMode": "normal",
  "effortLevel": "medium",
  "enabledPlugins": {
    "apple-notes@apple-notes-mcp": false,
    "asana@claude-plugins-official": false,
    "backend-development@claude-code-workflows": false,
    "ci-workflows@smartwatermelon-marketplace": true,
    "code-critic@smartwatermelon-marketplace": true,
    "code-documentation@claude-code-workflows": false,
    "code-refactoring@claude-code-workflows": false,
    "comprehensive-review@claude-code-workflows": true,
    "context7@claude-plugins-official": true,
    "debugging-toolkit@claude-code-workflows": false,
    "dependency-management@claude-code-workflows": false,
    "error-debugging@claude-code-workflows": false,
    "frontend-design@claude-plugins-official": false,
    "frontend-mobile-development@claude-code-workflows": false,
    "git-pr-workflows@claude-code-workflows": false,
    "i-have-adhd@i-have-adhd": true,
    "incident-response@claude-code-workflows": false,
    "personify@synced": false,
    "react-native-3d@smartwatermelon-marketplace": false,
    "security-compliance@claude-code-workflows": false,
    "slack@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": true,
    "tdd-workflows@claude-code-workflows": false,
    "team-collaboration@claude-code-workflows": false,
    "unit-testing@claude-code-workflows": false
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_ENV": "~/.config/bash/functions.sh",
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "extraKnownMarketplaces": {
    "apple-notes-mcp": {
      "source": {
        "repo": "sweetrb/apple-notes-mcp",
        "source": "github"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "git",
        "url": "https://github.com/smartwatermelon/claude-code-workflows-agents.git"
      }
    },
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "i-have-adhd": {
      "source": {
        "repo": "ayghri/i-have-adhd",
        "source": "github"
      }
    },
    "smartwatermelon-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/smartwatermelon/smartwatermelon-marketplace.git"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "gitAttribution": true,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/scripts/hook-redact-secret-output.py",
            "type": "command"
          }
        ],
        "matcher": "Bash|Read"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/hook-block-all.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/hook-block-merge-locks-write.sh",
            "type": "command"
          }
        ],
        "matcher": "Write"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/hook-block-merge-locks-write.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/hook-block-enter-worktree.sh",
            "type": "command"
          }
        ],
        "matcher": "EnterWorktree"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/hook-session-start.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/hook-budget-guard.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/hook-budget-guard.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "deny": [
      "mcp__claude_ai_Asana__add_comment",
      "mcp__claude_ai_Asana__create_project",
      "mcp__claude_ai_Asana__create_project_from_template",
      "mcp__claude_ai_Asana__create_project_status_update",
      "mcp__claude_ai_Asana__create_task_from_template",
      "mcp__claude_ai_Asana__create_tasks",
      "mcp__claude_ai_Asana__delete_task",
      "mcp__claude_ai_Asana__update_project",
      "mcp__claude_ai_Asana__update_tasks"
    ]
  },
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/scripts/status-line.sh",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "useAutoModeDuringPlan": false,
  "verbose": false,
  "workflowKeywordTriggerEnabled": false
}
