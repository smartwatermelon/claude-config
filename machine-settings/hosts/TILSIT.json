{
  "autoMode": {
    "environment": [
      "**Host containment (TILSIT)**: one of Andrew's personal Macs; Claude Code runs in its sandbox; network access is limited to an allowlist, and other hosts need approval per command. Clones live under ~/Developer/"
    ]
  },
  "enabledPlugins": {
    "cloudflare@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(gh secret delete *)",
      "Bash(gh auth logout *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(sudo *)",
      "Bash(gh secret set *)",
      "Bash(security add-generic-password *)",
      "Bash(security delete-generic-password *)",
      "Bash(launchctl bootstrap *)",
      "Bash(launchctl load *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "ssh *",
      "gh pr merge *",
      "${HOME}/.claude/scripts/gate-review.sh *",
      "rsync *",
      "scp *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Developer",
        "~/.local/state",
        "~/.cache",
        "~/Library/Caches",
        "/private/tmp/claude-501",
        "~/.semgrep",
        "${TMPDIR}"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "api.anthropic.com",
        "registry.npmjs.org",
        "semgrep.dev",
        "*.semgrep.dev",
        "my.1password.com",
        "*.1password.com",
        "*.blob.core.windows.net"
      ],
      "allowUnixSockets": ["/private/var/run/mDNSResponder"],
      "allowMachLookup": ["com.apple.pasteboard.1"]
    },
    "enableWeakerNetworkIsolation": true
  }
}
